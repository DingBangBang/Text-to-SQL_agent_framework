# ============================================================
# Text-to-SQL Agent Framework - environment template
# Copy to environment.env and fill in your own key.
# environment.env is git-ignored and never leaves your machine.
# ============================================================

# --- DeepSeek API (only used for intent parsing / SQL gen / summary) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- LLM mode: mock | deepseek ---------------------------------
# mock       : fully local, deterministic, zero API cost (default)
# deepseek   : real API, guarded by token/cost budgets
LLM_MODE=mock

# --- Local data warehouse (no raw data ever leaves the machine) ---
DUCKDB_PATH=data/analytics.duckdb
METRICS_PATH=metrics.yaml

# --- Cost guard: hard limits per single agent run ----------------
MAX_INPUT_TOKENS=3000
MAX_SQL_RETRIES=3
MAX_RUN_COST_CNY=1.0
LLM_TEMPERATURE=0.0

# --- Serving ----------------------------------------------------
STREAMLIT_PORT=8501
